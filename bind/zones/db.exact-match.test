$ORIGIN exact-match.test.
$TTL 60
@ IN SOA ns1.example.test. hostmaster.example.test. (
    2026092502 300 60 604800 60
)
  IN NS allapp-ns-01.exact-match.test.
  IN NS allapp-ns-02.exact-match.test.

allapp-a-01 IN A 192.0.2.101
allapp-a-01 IN AAAA 2001:db8::101
allapp-a-02 IN A 192.0.2.102
allapp-a-02 IN AAAA 2001:db8::102
allapp-aaaa-01 IN AAAA 2001:db8::101
allapp-aaaa-02 IN AAAA 2001:db8::102

allapp-cname-01 IN CNAME allapp-canonical-01.exact-match.test.
allapp-cname-02 IN CNAME allapp-canonical-02.exact-match.test.
allapp-cname-a-01 IN CNAME allapp-canonical-01.exact-match.test.
allapp-cname-a-02 IN CNAME allapp-canonical-02.exact-match.test.
allapp-canonical-01 IN A 192.0.2.103
allapp-canonical-01 IN AAAA 2001:db8::103
allapp-canonical-02 IN A 192.0.2.104
allapp-canonical-02 IN AAAA 2001:db8::104

allapp-mx-01 IN MX 10 allapp-mail-01.exact-match.test.
allapp-mx-02 IN MX 10 allapp-mail-02.exact-match.test.
allapp-mail-01 IN A 192.0.2.111
allapp-mail-01 IN AAAA 2001:db8::111
allapp-mail-02 IN A 192.0.2.112
allapp-mail-02 IN AAAA 2001:db8::112

allapp-srv-01 IN SRV 10 60 389 allapp-service-01.exact-match.test.
allapp-srv-02 IN SRV 10 60 389 allapp-service-02.exact-match.test.
allapp-service-01 IN A 192.0.2.121
allapp-service-01 IN AAAA 2001:db8::121
allapp-service-02 IN A 192.0.2.122
allapp-service-02 IN AAAA 2001:db8::122

_ldap._tcp.allapp-ad-srv-01 IN SRV 0 100 389 allapp-ad-dc-01.exact-match.test.
_ldap._tcp.allapp-ad-srv-02 IN SRV 0 100 389 allapp-ad-dc-02.exact-match.test.
allapp-ad-dc-01 IN A 192.0.2.151
allapp-ad-dc-01 IN AAAA 2001:db8::151
allapp-ad-dc-02 IN A 192.0.2.152
allapp-ad-dc-02 IN AAAA 2001:db8::152

allapp-ns-01 IN A 192.0.2.131
allapp-ns-01 IN AAAA 2001:db8::131
allapp-ns-02 IN A 192.0.2.132
allapp-ns-02 IN AAAA 2001:db8::132
allapp-https-01 IN HTTPS 1 allapp-https-target-01.exact-match.test. alpn="h2,h3" port=8443 ipv4hint=192.0.2.141 ipv6hint=2001:db8::141
allapp-https-02 IN HTTPS 1 allapp-https-target-02.exact-match.test. alpn="h2,h3" port=8443 ipv4hint=192.0.2.142 ipv6hint=2001:db8::142
allapp-https-target-01 IN A 192.0.2.141
allapp-https-target-01 IN AAAA 2001:db8::141
allapp-https-target-02 IN A 192.0.2.142
allapp-https-target-02 IN AAAA 2001:db8::142

; Large exact-match A RRsets exercise the supported DNS-over-TCP size path.
$GENERATE 1-240 allapp-large-a-01 IN A 192.0.2.$
$GENERATE 1-240 allapp-large-a-02 IN A 198.51.100.$
