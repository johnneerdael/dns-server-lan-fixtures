# Set these three values for your lab. Never point upstream DNS back at this service.
DNS_BIND_IPV4=127.0.0.1
DNS_ALLOWED_CLIENTS=127.0.0.1/32,::1/128
DNS_UPSTREAMS=

# The fixture service is the client-facing UDP/TCP endpoint.
DNS_FAULT_PORT=53
# Optional host-local BIND diagnostics; published on 127.0.0.1 only.
DNS_PORT=5300
# Optional IPv6 publication (compose.ipv6.yaml).
DNS_BIND_IPV6=::1
DNS_LAB_IPV6_SUBNET=fd63:13::/64
